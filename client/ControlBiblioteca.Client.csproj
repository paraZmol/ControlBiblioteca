<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ControlBiblioteca.Client</AssemblyName>
    <RootNamespace>ControlBiblioteca.Client</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- PublishSingleFile: todo el runtime en un único .exe -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Incluye las DLL nativas dentro del bundle -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Reducir tamaño: eliminar código sin usar -->
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- ReadyToRun: pre-compila el codigo a nativo. El kiosco arranca
         notablemente mas rapido (no compila JIT en cada inicio). El exe
         crece algo, pero la descarga sigue comprimida. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Net.WebSockets.Client y System.Text.Json ya vienen en net8.0;
         los paquetes NuGet viejos (4.3.2 / 8.0.4 con vulnerabilidad NU1903) se quitaron. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ExcludeFromSingleFile=true → el archivo queda FUERA del bundle, junto al .exe.
      Así el administrador puede editar la IP sin recompilar.
    -->
    <Content Include="kiosco.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Imagen de fondo embebida como recurso WPF -->
    <Resource Include="images\fondo_3.png" />
    <!-- Imágenes del comunicado informativo -->
    <Resource Include="images\comunicado_1.jpg" />
    <Resource Include="images\comunicado_2.jpg" />
  </ItemGroup>

</Project>
