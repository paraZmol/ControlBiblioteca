<Window x:Class="ControlBiblioteca.Client.UI.VentanaDesconexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Width="340" Height="130"
        SizeToContent="Height">

    <Border Background="#CC1a1a1a"
            BorderBrush="#FFD93D"
            BorderThickness="2"
            CornerRadius="10"
            Padding="16,14">

        <StackPanel>

            <!-- Título -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="⚠" FontSize="18" Foreground="#FFD93D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Sin conexión al servidor"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#FFD93D"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Instrucción -->
            <TextBlock Text="Guarda tu trabajo ahora."
                       FontSize="12" Foreground="#EEEEEE"
                       Margin="0,0,0,4"/>

            <!-- Cuenta regresiva -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="La PC se bloqueará en: "
                           FontSize="12" Foreground="#BBBBBB"/>
                <TextBlock x:Name="TxtCuentaRegresiva"
                           Text="3:00"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#FF6B6B"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
