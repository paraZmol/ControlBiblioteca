      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  :root {\n    --accent: #8b5cf6;\n    --accent-soft: rgba(139, 92, 246, 0.1);\n    --border: #e2e8f0;\n    --bg-main: #f8fafc;\n  }\n\n  body {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    background-color: var(--bg-main);\n    color: #1e293b;\n    margin: 0;\n    overflow: hidden;\n  }\n\n  .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }\n  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }\n  .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }\n  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }\n\n  /* Node Map Lines Animation */\n  @keyframes dash {\n    to { stroke-dashoffset: 0; }\n  }\n  .map-line {\n    stroke: #cbd5e1;\n    stroke-width: 1;\n    stroke-dasharray: 4 4;\n    stroke-dashoffset: 8;\n    animation: dash 5s linear infinite;\n  }\n</style>\n\n<div class=\"flex h-screen w-full overflow-hidden\" data-kid=\"1\">\n  \n  \n  <aside class=\"group/sidebar w-16 hover:w-64 bg-white border-r border-slate-200 h-full flex flex-col transition-all duration-300 z-50 shadow-sm\" data-kid=\"2\">\n    <div class=\"h-16 flex items-center px-4 border-b border-slate-100 gap-3\" data-kid=\"3\">\n      <div class=\"w-8 h-8 rounded-lg bg-[#8b5cf6] flex items-center justify-center shrink-0 shadow-lg shadow-purple-500/20\" data-kid=\"4\">\n        <i class=\"ti ti-binary text-white text-lg\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"font-extrabold text-slate-900 tracking-tight opacity-0 group-hover/sidebar:opacity-100 transition-opacity overflow-hidden whitespace-nowrap\" data-kid=\"6\">UNASAM CTRL</span>\n    </div>\n\n    <nav class=\"flex-1 py-6 px-2 space-y-2 ov