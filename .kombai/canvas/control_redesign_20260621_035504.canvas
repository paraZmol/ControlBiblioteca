w-violet flex items-center justify-center border border-white/20\" data-kid=\"71\"></div>\n    </div>\n\n    \n    <div class=\"absolute bottom-0 left-0 right-0 bg-[#F43F5E] h-12 flex items-center overflow-hidden z-30 shadow-[0_-10px_30px_rgba(244,63,94,0.3)]\" data-kid=\"72\">\n      <div class=\"animate-marquee whitespace-nowrap flex items-center gap-12\" data-kid=\"73\">\n        <span class=\"font-mono text-sm font-bold flex items-center gap-2\" data-kid=\"74\">\n          <i class=\"ti ti-alert-triangle\" data-kid=\"75\"></i> INCIDENCIA CRÍTICA: USUARIO ABEL ANICETO EJECUTÓ POWERSHELL EN PC-06\n        </span>\n        <span class=\"font-mono text-sm font-bold flex items-center gap-2\" data-kid=\"76\">\n          <i class=\"ti ti-shield-x\" data-kid=\"77\"></i> BANEO RECOMENDADO: JORGE MILLER (3 ADVERTENCIAS LEVES)\n        </span>\n        <span class=\"font-mono text-sm font-bold flex items-center gap-2 text-white/60\" data-kid=\"78\">\n          SYSTEM STATUS: ALL NODES SYNCHRONIZED // LOCAL WS ONLINE\n        </span>\n        <span class=\"font-mono text-sm font-bold flex items-center gap-2\" data-kid=\"79\">\n          <i class=\"ti ti-alert-triangle\" data-kid=\"80\"></i> INCIDENCIA CRÍTICA: USUARIO ABEL ANICETO EJECUTÓ POWERSHELL EN PC-06\n        </span>\n      </div>\n    </div>\n\n    \n    <div class=\"absolute top-12 right-12 w-64 space-y-6\" data-kid=\"81\">\n      <div class=\"bg-white/5 backdrop-blur-xl border border-white/10 p-6 rounded-2xl\" data-kid=\"82\">\n        <p class=\"font-mono text-[10px] text-white/40 mb-3 tracking-tighter uppercase\" data-kid=\"83\">// Active Alert</p>\n        <div class=\"flex items-start gap-4\" data-kid=\"84\">\n          <div class=\"w-10 h-10 rounded-lg bg-rose-500/20 text-rose-500 flex items-center justify-center shrink-0 border border-rose-500/30\" data-kid=\"85\">\n            <i class=\"ti ti-shield-alert text-xl\" data-kid=\"86\"></i>\n          </div>\n          <div data-kid=\"87\">\n            <p cla