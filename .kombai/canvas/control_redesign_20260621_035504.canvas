ass=\"flex items-center gap-2 px-6 py-3 bg-[#2C2C30] hover:bg-[#3F3F46] border border-white/5 rounded-2xl text-xs font-bold transition-all\" data-kid=\"62\">\n          <i class=\"ti ti-layout-grid text-lg\" data-kid=\"63\"></i> Galería\n        </button>\n        <button class=\"flex items-center gap-2 px-6 py-3 bg-white text-black rounded-2xl text-xs font-extrabold shadow-xl shadow-white/10 hover:scale-105 active:scale-95 transition-all\" data-kid=\"64\">\n          <i class=\"ti ti-lock-access text-lg\" data-kid=\"65\"></i> BLOQUEAR SALA\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6\" data-kid=\"66\">\n      \n      \n      <div class=\"group relative p-6 rounded-[24px] glass-card border-t border-white/10 hover:border-violet-500/50 transition-all duration-500 hover:-translate-y-2\" data-kid=\"67\">\n        <div class=\"flex justify-between items-start mb-6\" data-kid=\"68\">\n          <div class=\"w-10 h-10 rounded-xl bg-violet-500/20 border border-violet-500/30 flex items-center justify-center text-violet-400 group-hover:scale-110 transition-transform\" data-kid=\"69\">\n            <i class=\"ti ti-device-computer-camera text-xl\" data-kid=\"70\"></i>\n          </div>\n          <div class=\"flex h-2 w-2 relative\" data-kid=\"71\">\n            <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-violet-400 opacity-75\" data-kid=\"72\"></span>\n            <span class=\"relative inline-flex rounded-full h-2 w-2 bg-violet-500\" data-kid=\"73\"></span>\n          </div>\n        </div>\n        <h4 class=\"font-heading text-lg font-black group-hover:text-violet-400 transition-colors\" data-kid=\"74\">YORU</h4>\n        <p class=\"text-[10px] font-mono text-zinc-500 mb-4\" data-kid=\"75\">10.21.1.122</p>\n        \n        <div class=\"p-3 bg-white/5 rounded-xl border border-white/5 mb-6\" data-kid=\"76\">\n          <p class=\"text-[10px] text-zinc-400 uppercase font-bold mb-1\" data-kid=\"77\">Usuario</p>\n          <p class=\"text-xs font-bold text-white truncate\" data-kid=\"78\">Jorge Miller Nuñez</p>\n          <div class=\"flex justify-between items-center mt-2 pt-2 border-t border-white/5\" data-kid=\"79\">\n             <span class=\"text-[9px] text-zinc-500 font-mono\" data-kid=\"80\">UPTIME: 2h 15m</span>\n             <i class=\"ti ti-activity text-emerald-400 text-xs\" data-kid=\"81\"></i>\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-2 opacity-0 group-hover:opacity-100 transition-opacity translate-y-2 group-hover:translate-y-0 duration-300\" data-kid=\"82\">\n          <button class=\"p-2 bg-rose-500/20 text-rose-400 rounded-lg hover:bg-rose-500 hover:text-white transition-all\" data-kid=\"83\">\n            <i class=\"ti ti-lock\" data-kid=\"84\"></i>\n          </button>\n          <button class=\"p-2 bg-white/10 text-white rounded-lg hover:bg-white hover:text-black transition-all\" data-kid=\"85\">\n            <i class=\"ti ti-power\" data-kid=\"86\"></i>\n          </button>\n        </div>\n      </div>\n\n      \n      <div class=\"group relative p-6 rounded-[24px] glass-card border-t border-white/10 hover:border-emerald-500/50 transition-all duration-500 hover:-translate-y-2\" data-kid=\"87\">\n        <div class=\"flex justify-between items-start mb-6\" data-kid=\"88\">\n          <div class=\"w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-500\" data-kid=\"89\">\n            <i class=\"ti ti-device-computer-camera text-xl\" data-kid=\"90\"></i>\n          </div>\n          <div class=\"h-2 w-2 rounded-full bg-emerald-500\" data-kid=\"91\"></div>\n        </div>\n        <h4 class=\"font-heading text-lg font-black\" data-kid=\"92\">MEICAGOD</h4>\n        <p class=\"text-[10px] font-mono text-zinc-500 mb-4\" data-kid=\"93\">10.21.1.121</p>\n        \n        <div class=\"py-4 border-y bo