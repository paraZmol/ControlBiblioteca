      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-editorial { font-family: 'Syne', sans-serif; }\n  .font-mono { font-family: 'JetBrains Mono', monospace; }\n  .font-sans { font-family: 'Inter', sans-serif; }\n\n  .iso-grid {\n    transform: rotateX(55deg) rotateZ(-45deg);\n    transform-style: preserve-3d;\n  }\n\n  .pc-block {\n    transform-style: preserve-3d;\n    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n  }\n\n  .pc-block:hover {\n    transform: translateZ(20px);\n  }\n\n  .pc-block.active {\n    transform: translateZ(40px);\n  }\n\n  .glow-violet { box-shadow: 0 0 30px rgba(139, 92, 246, 0.4); }\n  .glow-emerald { box-shadow: 0 0 30px rgba(16, 185, 129, 0.3); }\n  .glow-amber { box-shadow: 0 0 30px rgba(245, 158, 11, 0.3); }\n\n  @keyframes marquee {\n    0% { transform: translateX(100%); }\n    100% { transform: translateX(-100%); }\n  }\n  .animate-marquee {\n    animation: marquee 30s linear infinite;\n  }\n\n  /* Radial Menu Animation */\n  .radial-item {\n    transition: all 0.3s ease;\n    opacity: 0;\n    transform: scale(0.5);\n  }\n  .radial-menu:hover .radial-item {\n    opacity: 1;\n    transform: scale(1);\n  }\n</style>\n\n<div class=\"flex h-screen w-full bg-[#080808] text-white font-sans overflow-hidden select-none\" data-kid=\"1\">\n  \n  \n  <aside class=\"w-[30%] h-full bg-gradient-to-b from-[#121212] to-[#1E1B4B] p-12 flex flex-col justify-between border-r border-white/5 relative z-20\" data-kid=\"2\">\n    <div class=\"space-y-12\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-10 h-10 bg-[#8B5CF6] rounded-full flex items-center justify-center shadow-[0_0_20px_rgba(139,92,246,0.5)]\" data-kid=\"5\">\n          <i class=\"ti