      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap');\n</style>\n<script src=\"https://unpkg.com/@phosphor-icons/web\" data-kid=\"1\"></script>\n\n<div class=\"dark min-h-screen w-full bg-[#09090b] text-zinc-100 flex overflow-hidden\" style=\"font-family:'Plus Jakarta Sans',system-ui,sans-serif\" data-kid=\"2\">\n  \n  <aside class=\"w-[260px] min-w-[260px] h-screen flex flex-col justify-between bg-zinc-900/80 backdrop-blur-xl border-r border-zinc-800/80\" data-kid=\"3\">\n    <div data-kid=\"4\">\n      <div class=\"h-[72px] flex items-center gap-3 px-6 border-b border-zinc-800/80\" data-kid=\"5\">\n        <div class=\"w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white font-black text-lg shadow-lg shadow-indigo-500/20\" data-kid=\"6\">U</div>\n        <div data-kid=\"7\">\n          <h1 class=\"text-sm font-extrabold tracking-tight text-zinc-100 leading-tight\" data-kid=\"8\">UNASAM</h1>\n          <p class=\"text-[10px] font-medium text-zinc-500 tracking-widest uppercase\" style=\"font-family:'JetBrains Mono',monospace\" data-kid=\"9\">Biblioteca_OS</p>\n        </div>\n      </div>\n\n      <nav class=\"p-4 flex flex-col gap-1\" data-kid=\"10\">\n        <button class=\"nav-item-active group relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-indigo-400 bg-indigo-500/10 border border-indigo-500/10\" data-kid=\"11\">\n          <span class=\"absolute left-0 top-2 bottom-2 w-1 bg-indigo-500 rounded-r-full\" data-kid=\"12\"></span>\n          <i class=\"ph ph-cpu text-lg\" data-kid=\"13\"></i>\n          <span data-kid=\"14\">Monitoreo</span>\n        </button>\n        <button class=\"flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/60 trans