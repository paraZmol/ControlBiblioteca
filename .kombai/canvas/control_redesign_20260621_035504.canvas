      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-bg: #000000;\n    --color-surface: #121212;\n    --color-accent: #eab308; /* Metallic Gold */\n    --color-alert: #dc2626;  /* Crimson */\n    --color-success: #10b981;\n    --font-sans: 'Geist', sans-serif;\n    --font-serif: 'Playfair Display', serif;\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: #f8fafc;\n    font-family: var(--font-sans);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .footlight-glow {\n    box-shadow: 0 4px 12px -2px rgba(234, 179, 8, 0.4);\n  }\n\n  .topographic-bg {\n    background-image: url('https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/treasure-map.svg');\n    background-size: 400px;\n    opacity: 0.05;\n    filter: invert(1);\n  }\n\n  .pulsar {\n    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n  }\n\n  @keyframes pulse {\n    0%, 100% { opacity: 1; transform: scale(1); }\n    50% { opacity: 0.5; transform: scale(1.2); }\n  }\n\n  .list-card {\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .list-card:hover {\n    background-color: #1a1a1a;\n    transform: translateX(4px);\n  }\n\n  .action-buttons {\n    opacity: 0;\n    transform: translateX(10px);\n    transition: all 0.2s ease-out;\n  }\n\n  .list-card:hover .action-buttons {\n    opacity: 1;\n    transform: translateX(0);\n  }\n</style>\n\n<div class=\"min-h-screen flex flex-col\" data-kid=\"1\">\n  \n  <nav class=\"sticky top-0 z-50 bg-black/80 backdrop-blur-xl border-b border-white/5 px-8 h-20 flex items-center justify-between\" data-kid=\"2\">\n    <div class=\"flex items-center gap-12\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center\" data-kid=\"5\">\n          <i class=\"ti ti-shield-check text-black text-2xl\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"text-xl font-bold tracking-tight uppercase\" data-kid=\"7\">Control <span class=\"text-amber-500 italic\" data-kid=\"8\">Unasam</span></span>\n      </div>\n\n      <div class=\"hidden lg:flex items-center gap-8\" data-kid=\"9\">\n        <a href=\"#\" class=\"relative h-20 flex items-center px-2 text-sm font-semibold text-amber-500 tracking-wide\" data-kid=\"10\">\n          MONITOREO\n          <div class=\"absolute bottom-0 left-0 right-0 h-[2px] bg-amber-500 footlight-glow\" data-kid=\"11\"></div>\n        </a>\n        <a href=\"#\" class=\"h-20 flex items-center px-2 text-sm font-semibold text-white/50 hover:text-white transition-colors tracking-wide\" data-kid=\"12\">ACTIVIDAD</a>\n        <a href=\"#\" class=\"h-20 flex items-center px-2 text-sm font-semibold text-white/50 hover:text-white transition-colors tracking-wide\" data-kid=\"13\">HISTORIAL</a>\n        <a href=\"#\" class=\"h-20 flex items-center px-2 text-sm font-semibold text-white/50 hover:text-white transition-colors tracking-wide\" data-kid=\"14\">CONFIGURACIÓN</a>\n      </div>\n    </div>\n\n    <div class=\"flex items-center gap-6\" data-kid=\"15\">\n      <div class=\"flex items-center gap-2 bg-white/5 rounded-full px-4 py-2 border border-white/10\" data-kid=\"16\">\n        <div class=\"w-2 h-2 rounded-full bg-emerald-500 pulsar\" data-kid=\"17\"></div>\n        <span class=\"text-xs font-mono text-emerald-500\" data-kid=\"18\">SERVER ONLINE</span>\n      </div>\n      <div class=\"w-10 h-10 rounded-full bg-white/10 flex items-center justify-center border border-white/20\" data-kid=\"19\">\n        <i class=\"ti ti-bell text-lg\" data-kid=\"20\"></i>\n      </div>\n      <div class=\"flex items-center gap-3 pl-4 border-l border-white/10\" data-kid=\"21\">\n        <div class=\"text-right hidden sm:block\" data-kid=\"22\">\n          <p class=\"text-sm font-bold\" data-kid=\"23\">Admin Central</p>\n          <p class=\"text-[10px] text-white/40 uppercase tracking-widest\" data-kid=\"24\">Superuser</p>\n        </div>\n        <img src=\"https://i.pravatar.cc/100?u=admin\" class=\"w-10 h-10 rounded-xl border border-white/20\" loading=\"lazy\" decoding=\"async\" data-kid=\"25\">\n      </div>\n    </div>\n  </nav>\n\n  <main class=\"flex-1 p-8 space-y-12 max-w-[1600px] mx-auto w-full\" data-kid=\"26\">\n    \n    \n    <section class=\"relative bg-surface rounded-3xl overflow-hidden border border-white/5\" data-kid=\"27\">\n      <div class=\"absolute inset-0 topographic-bg\" data-kid=\"28\"></div>\n      <div class=\"relative z-10 flex flex-wrap lg:flex-nowrap divide-y lg:divide-y-0 lg:divide-x divide-white/5\" data-kid=\"29\">\n        <div class=\"flex-1 p-10 space-y-2\" data-kid=\"30\">\n          <p class=\"text-white/40 text-xs font-bold uppercase tracking-[0.2em]\" data-kid=\"31\">Equipos Activos</p>\n          <div class=\"flex items-baseline gap-4\" data-kid=\"32\">\n            <h2 class=\"text-7xl font-serif text-amber-500 leading-none\" data-kid=\"33\">24</h2>\n            <div class=\"flex items-center gap-1 text-emerald-500 text-sm font-bold\" data-kid=\"34\">\n              <i class=\"ti ti-trending-up\" data-kid=\"35\"></i> 12%\n            </div>\n          </div>\n          <p class=\"text-white/20 text-xs italic font-serif\" data-kid=\"36\">Capacidad actual: 88%</p>\n        </div>\n        <div class=\"flex-1 p-10 space-y-2\" data-kid=\"37\">\n          <p class=\"text-white/40 text-xs font-bold uppercase tracking-[0.2em]\" data-kid=\"38\">Sesiones Totales</p>\n          <div class=\"flex items-baseline gap-4\" data-kid=\"39\">\n            <h2 class=\"text-7xl font-serif text-white leading-none\" data-kid=\"40\">142</h2>\n            <div class=\"flex items-center gap-1 text-emerald-500 text-sm font-bold\" data-kid=\"41\">\n              <i class=