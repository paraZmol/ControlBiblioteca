      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Rajdhani:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --hud-cyan: #00F0FF;\n    --hud-cyan-dim: rgba(0, 240, 255, 0.15);\n    --hud-black: #05050A;\n    --hud-crimson: #FF2A2A;\n    --hud-amber: #FFB000;\n    --hud-emerald: #00FF66;\n  }\n\n  .font-hud { font-family: 'Rajdhani', sans-serif; }\n  .font-body { font-family: 'Inter', sans-serif; }\n\n  .bg-void { background-color: var(--hud-black); }\n  .text-neon { color: var(--hud-cyan); text-shadow: 0 0 8px rgba(0, 240, 255, 0.5); }\n  .border-neon { border-color: rgba(0, 240, 255, 0.3); }\n  .bg-neon-dim { background-color: var(--hud-cyan-dim); }\n\n  .glass-hud {\n    background: rgba(10, 10, 20, 0.7);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(0, 240, 255, 0.1);\n    box-shadow: inset 0 0 20px rgba(0, 240, 255, 0.05);\n  }\n\n  /* Scanline effect */\n  .scanline::before {\n    content: \" \";\n    display: block;\n    position: absolute;\n    top: 0; left: 0; bottom: 0; right: 0;\n    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));\n    z-index: 50;\n    background-size: 100% 4px, 3px 100%;\n    pointer-events: none;\n    opacity: 0.1;\n  }\n\n  /* Floating animation */\n  @keyframes float {\n    0% { transform: translateY(0px); }\n    50% { transform: translateY(-10px); }\n    100% { transform: translateY(0px); }\n  }\n  .animate-float { animation: float 4s ease-in-out infinite; }\n\n  /* Radial Hub Nav */\n  .nav-hub {\n    position: absolute;\n    bottom: -40px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 400px;\n    height: 200px;\n    background: radial-gradient(circle at top, var(--hud-cyan-dim) 0%, transparent 70%);\n    border-radius: 200px 200px 0 0;\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    padding-top: 30px;\n    border-top: 2px solid var(--hud-cyan);\n    box-shadow: 0 -10px 40px rgba(0, 240, 255, 0.2);\n    z-index: 100;\n  }\n\n  .nav-item {\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n  .nav-item:hover {\n    color: var(--hud-cyan);\n    transform: scale(1.1) translateY(-5px);\n    text-shadow: 0 0 15px var(--hud-cyan);\n  }\n\n  /* Constellation Graph */\n  .pc-node {\n    position: absolute;\n    cursor: pointer;\n    transition: all 0.3s ease;\n  }\n  .pc-node:hover {\n    transform: scale(1.2);\n    z-index: 20;\n  }\n  .node-pulse {\n    position: absolute;\n    width: 100%;\n    height: 100%;\n    border-radius: 50%;\n    background: var(--hud-cyan);\n    opacity: 0.5;\n    animation: pulse 2s infinite;\n  }\n  @keyframes pulse {\n    0% { transform: scale(1); opacity: 0.5; }\n    100% { transform: scale(2.5); opacity: 0; }\n  }\n\n  /* Ticker Waterfall */\n  .ticker-item {\n    animation: slideInRight 0.5s ease-out;\n  }\n  @keyframes slideInRight {\n    from { transform: translateX(100%); opacity: 0; }\n    to { transform: translateX(0); opacity: 1; }\n  }\n</style>\n\n<div class=\"relative w-full h-[900px] bg-void overflow-hidden scanline font-body text-zinc-400\" data-kid=\"1\">\n  \n  \n  <img src=\"https://images.unsplash.com/photo-1644088379091-d574269d422f?auto=format&w=1600&q=40&fit=crop\" alt=\"Network background\" class=\"absolute inset-0 w-full h-full object-cover opacity-10 mix-blend-screen\" decoding=\"async\" loading=\"lazy\" data-kid=\"2\">\n\n  \n  <header class=\"absolute top-8 left-1/2 -translate-x-1/2 flex gap-6 z-40\" data-kid=\"3\">\n    <div class=\"glass-hud px-8 py-4 rounded-2xl flex flex-col items-center border-t-2 border-t-neon\" data-kid=\"4\">\n      <span class=\"font-hud text-xs tracking-widest text-zinc-500 uppercase\" data-kid=\"5\">System Status</span>\n      <div class=\"flex items-center gap-3 mt-1\" data-kid=\"6\">\n        <span class=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" data-kid=\"7\"></span>\n        <span class=\"font-hud text-2xl font-bold text-white tracking-tight\" data-kid=\"8\">OPERATIONAL</span>\n      </div>\n    </div>\n    \n    <div class=\"glass-hud px-10 py-4 rounded-2xl flex gap-12 border-b-2 border-b-neon\" data-kid=\"9\">\n      <div class=\"text-center\" data-kid=\"10\">\n        <span class=\"font-hud text-xs tracking-widest text-zinc-500 uppercase\" data-kid=\"11\">Live Nodes</span>\n        <p class=\"font-hud text-3xl font-bold text-neon mt-1\" data-kid=\"12\">24 / 27</p>\n      </div>\n      <div class=\"text-center border-l border-zinc-800 pl-12\" data-kid=\"13\">\n        <span class=\"font-hud text-xs tracking-widest text-zinc-500 uppercase\" data-kid=\"14\">Net Load</span>\n        <p class=\"font-hud text-3xl font-bold text-neon mt-1\" data-kid=\"15\">1.2 <span class=\"text-sm font-normal text-zinc-500\" data-kid=\"16\">GBPS</span></p>\n      </div>\n      <div class=\"text-center border-l border-zinc-800 pl-12\" data-kid=\"17\">\n        <span class=\"font-hud text-xs tracking-widest text-zinc-500 uppercase\" data-kid=\"18\">Threat Level</span>\n        <p class=\"font-hud text-3xl font-bold text-amber-500 mt-1\" data-kid=\"19\">MINIMAL</p>\n      </div>\n    </div>\n\n    <div class=\"glass-hud px-6 py-4 rounded-2xl flex items-center justify-center\" data-kid=\"20\">\n      <button class=\"p-2 hover:text-neon transition-colors\" data-kid=\"21\"><i class=\"ti ti-settings text-xl\" data-kid=\"22\"></i></button>\n      <div class=\"w-px h-6 bg-zinc-800 mx-4\" data-kid=\"23\"></div>\n      <button class=\"p-2 hover:text-rose-500 transition-colors\" data-kid=\"24\"><i class=\"ti ti-power text-xl\" data-kid=\"25\"></i></button>\n    </div>\n  </header>\n\n  \n  <aside class=\"absolute top-32 left-8 w-80 space-y-6 z-30\" data-kid=\"26\">\n    <div class=\"glass-hud p-6 rounded-3xl border-l-4 border-l-neon\" data-kid=\"27\">\n      <h2 class=\"font-hud text-lg font-bold text-white tracking-widest mb-4 flex items-center gap-2\" data-kid=\"28\">\n        <i class=\"ti ti-activity text-neon\" data-kid=\"29\"></i> RADAR SCAN\n      </h2>\n      <div class=\"space-y-4\" data-kid=\"30\">\n        <div class=\"relative h-1 bg-zinc-800 rounded-full overflow-hidden\" data-kid=\"31\">\n          <div class=\"absolute h-full bg-neon w-[85%] animate-[progress_2s_ease-in-out]\" data-kid=\"32\"></div>\n        </div>\n        <div class=\"flex justify-between text-xs font-hud tracking-widest\" data-kid=\"33\">\n          <span data-kid=\"34\">CAPACITY</span>\n          <span class=\"text-neon\" data-kid=\"35\">85.4%</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"glass-hud p-6 rounded-3xl border-l-4 border-l-rose-500/50\" data-kid=\"36\">\n      <h2 class=\"font-hud text-lg font-bold text-rose-500 tracking-widest mb-4 flex items-center gap-2 uppercase\" data-kid=\"37\">\n        <i class=\"ti ti-alert-triangle text-rose-500\" data-kid=\"38\"></i> Critical Alerts\n      </h2>\n      <div class=\"space-y-3\" data-kid=\"39\">\n        <div class=\"p-3 bg-rose-500/10 rounded-xl border border-rose-500/20\" data-kid=\"40\">\n          <p class=\"text-xs font-bold text-rose-400 uppercase\" data-kid=\"41\">YOTSUBITA (PC-03)</p>\n          <p class=\"text-xs text-zinc-400 mt-1\" data-kid=\"42\">Cmd.exe execution detected.</p>\n        </div>\n        <div class=\"p-3 bg-amber-500/10 rounded-xl border border-amber-500/20\" data-kid=\"43\">\n          <p class=\"text-xs font-bold text-amber-400 uppercase\" data-kid=\"44\">MEICAGOD (PC-01)</p>\n          <p class=\"text-xs text-zinc-400 mt-1\" data-kid=\"45\">High network usage warning.</p>\n        </div>\n      </div>\n    </div>\n  </aside>\n\n  \n  <div class=\"absolute inset-0 pointer-events-none\" data-kid=\"46\">\n    \n    <svg class=\"absolute inset-0 w-full h-full opacity-20\" stroke=\"var(--hud-cyan)\" stroke