      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Open+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    background-color: #18181A;\n    color: #FFFFFF;\n    font-family: 'Open Sans', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-heading { font-family: 'Montserrat', sans-serif; }\n  .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n  .cinematic-shadow {\n    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);\n  }\n\n  .glass-card {\n    background: #222225;\n    border: 1px solid rgba(255, 255, 255, 0.05);\n    backdrop-filter: blur(10px);\n  }\n\n  .glow-violet { box-shadow: 0 0 20px rgba(139, 92, 246, 0.3); }\n  .glow-orange { box-shadow: 0 0 20px rgba(249, 115, 22, 0.3); }\n\n  .gradient-violet {\n    background: linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%);\n  }\n\n  .gradient-orange {\n    background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);\n  }\n\n  .wave-bg {\n    mask-image: url('https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/waves.svg');\n    mask-size: cover;\n    opacity: 0.1;\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 8px; }\n  ::-webkit-scrollbar-track { background: #18181A; }\n  ::-webkit-scrollbar-thumb { background: #2C2C30; border-radius: 10px; }\n  ::-webkit-scrollbar-thumb:hover { background: #3F3F46; }\n</style>\n\n<div class=\"min-h-screen p-8 pb-32 relative\" data-kid=\"1\">\n  \n  <div class=\"absolute -top-40 -left-40 w-96 h-96 bg-violet-600/10 rounded-full blur-[120px]\" data-kid=\"2\"></div>\n  <div class=\"absolute -top-40 -right-40 w-96 h-96 bg-orange-600/10 rounded-full blur-[120px]\" data-kid=\"3\"></div>\n\n  \n  <header class=\"relative z-30 flex justify-between items-center mb-16\" data-kid=\"4\">\n    <div class=\"flex items-center gap-4\" data-kid=\"5\">\n      <div class=\"w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center\" data-kid=\"6\">\n        <img src=\"https://admin.biblioteca.unasam.edu.pe/static/uploads/logo_1781823422.svg\" class=\"w-8 h-8 opacity-90\" alt=\"Logo\" data-kid=\"7\">\n      </div>\n      <div data-kid=\"8\">\n        <h1 class=\"font-heading text-xl font-extrabold tracking-tight\" data-kid=\"9\">CONTROL <span class=\"text-violet-500\" data-kid=\"10\">BIBLIOTECA</span></h1>\n        <p class=\"text-[10px] text-zinc-500 font-bold uppercase tracking-[0.2em]\" data-kid=\"11\">UNASAM // Admin Dashboard</p>\n      </div>\n    </div>\n\n    <div class=\"flex items-center gap-6\" data-kid=\"12\">\n      <div class=\"relative group\" data-kid=\"13\">\n        <i class=\"ti ti-search absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500 group-focus-within:text-violet-400 transition-colors\" data-kid=\"14\"></i>\n        <input type=\"text\" placeholder=\"Comando rápido (Ctrl + K)\" class=\"bg-[#222225] border border-white/5 rounded-2xl pl-12 pr-6 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-violet-500/50 w-80 transition-all\" data-kid=\"15\">\n      </div>\n      <div class=\"flex items-center gap-3 pl-6 border-l border-white/10\" data-kid=\"16\">\n        <div class=\"text-right hidden sm:block\" data-kid=\"17\">\n          <p class=\"text-xs font-bold text-white\" data-kid=\"18\">Admin</p>\n          <p class=\"text-[10px] text-emerald-400 font-mono\" data-kid=\"19\">ONLINE</p>\n        </div>\n        <div class=\"w-10 h-10 rounded-xl bg-violet-500/20 border border-violet-500/30 flex items-center justify-center\" data-kid=\"20\">\n          <i class=\"ti ti-user text-violet-400\" data-kid=\"21\"></i>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"relative z-20 grid grid-cols-1 md:grid-cols-3 gap-8 mb-16\" data-kid=\"22\">\n    \n    <div class=\"relative group overflow-hidden rounded-[24px] p-8