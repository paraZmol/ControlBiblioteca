      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    font-family: 'Inter', sans-serif;\n    background-color: #09090b; /* zinc-950 */\n    color: #f4f4f5; /* zinc-100 */\n    margin: 0;\n    overflow: hidden;\n  }\n\n  .wasabi-glow {\n    box-shadow: 0 0 20px rgba(120, 209, 59, 0.2);\n  }\n\n  .glass-surface {\n    background: rgba(24, 24, 27, 0.6); /* zinc-900/60 */\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  .scrollbar-hide::-webkit-scrollbar {\n    display: none;\n  }\n\n  .animate-blink {\n    animation: blink 1.5s infinite;\n  }\n\n  @keyframes blink {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0.4; }\n  }\n</style>\n\n<div class=\"flex h-screen w-full relative\" data-kid=\"1\">\n  \n  <aside class=\"w-[260px] h-full flex flex-col border-r border-white/5 glass-surface z-50\" data-kid=\"2\">\n    <div class=\"p-8 pb-4\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center wasabi-glow\" data-kid=\"5\">\n          <i class=\"ti ti-layout-2-filled text-white text-xl\" data-kid=\"6\"></i>\n        </div>\n        <div data-kid=\"7\">\n          <h1 class=\"font-extrabold text-lg tracking-tight leading-none\" data-kid=\"8\">BIBLIOTECA</h1>\n          <p class=\"text-[10px] text-zinc-500 font-bold tracking-[0.2em] mt-1\" data-kid=\"9\">UNASAM // ADMIN</p>\n        </div>\n      </div>\n    </div>\n\n    <nav class=\"flex-1 px-4 py-6 space-y-1\" data-kid=\"10\">\n      <div class=\"text-[10px] font-bold text-zinc-500 uppercase tracking-widest px-4 mb-4\" data-kid=\"11\">Dashboard</div>\n      <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl bg-indigo-600/