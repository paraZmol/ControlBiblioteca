      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --gold: #eab308;\n    --crimson: #dc2626;\n    --charcoal: #121212;\n    --surface: #1a1a1a;\n  }\n\n  body {\n    background-color: #000000;\n    color: #ffffff;\n    font-family: 'Geist', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-serif {\n    font-family: 'Playfair Display', serif;\n  }\n\n  .footlight-glow {\n    box-shadow: 0 4px 12px -1px rgba(234, 179, 8, 0.3);\n  }\n\n  .topo-pattern {\n    background-image: url('https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/wavy-itinerary.svg');\n    background-size: 400px;\n    opacity: 0.03;\n    filter: invert(1);\n  }\n\n  .custom-scrollbar::-webkit-scrollbar {\n    width: 4px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    background: #333;\n    border-radius: 10px;\n  }\n</style>\n\n<div class=\"min-h-screen flex flex-col relative\" data-kid=\"1\">\n  \n  \n  <header class=\"h-20 bg-[#121212] border-b border-[#eab308]/10 flex items-center px-12 justify-between sticky top-0 z-50\" data-kid=\"2\">\n    <div class=\"flex items-center gap-10\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-10 h-10 bg-[#eab308] rounded-lg flex items-center justify-center\" data-kid=\"5\">\n          <i class=\"ti ti-shield-check text-black text-2xl\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"text-xl font-bold tracking-tight\" data-kid=\"7\">UNASAM <span class=\"text-[#eab308]/60 font-medium\" data-kid=\"8\">CONTROL</span></span>\n      </div>\n      \n      <nav class=\"flex gap-8 h-20 items-center\" data-kid=\"9\">\n        <a href=\"#\" class=\"text-sm font-semibold tracking-wide border-b-2 border-[#eab308] h-20 flex items-center px-2 text-[#eab308] footlight-glow\" data-kid=\"10\">MONITOREO</a>\n        <a href=\"#\" class=\"text-sm font-semibold tracking-wide text-zinc-500 hover:text-white transition-colors h-20 flex items-center px-2\" data-kid=\"11\">ACTIVIDAD</a>\n        <a href=\"#\" class=\"text-sm font-semibold tracking-wide text-zinc-500 hover:text-white transition-colors h-20 flex items-center px-2\" data-kid=\"12\">HISTORIAL</a>\n        <a href=\"#\" class=\"text-sm font-semibold tracking-wide text-zinc-500 hover:text-white transition-colors h-20 flex items-center px-2 relative\" data-kid=\"13\">\n          ALERTAS\n          <span class=\"absolute top-6 -right-1 w-2 h-2 bg-red-600 rounded-full animate-pulse\" data-kid=\"14\"></span>\n        </a>\n      </nav>\n    </div>\n\n    <div class=\"flex items-center gap-6\" data-kid=\"15\">\n      <div class=\"text-right hidden md:block\" data-kid=\"16\">\n        <p class=\"text-xs font-bold text-[#eab308]\" data-kid=\"17\">ADMINISTRADOR</p>\n        <p class=\"text-[10px] text-zinc-500 uppercase tracking-widest\" data-kid=\"18\">SISTEMA NIVEL 1</p>\n      </div>\n      <div class=\"w-10 h-10 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center overflow-hidden\" data-kid=\"19\">\n        <img src=\"https://i.pravatar.cc/100?u=unasam\" alt=\"Admin\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover\" data-kid=\"20\">\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"relative bg-[#121212] border-b border-zinc-800 overflow-hidden\" data-kid=\"21\">\n    <div class=\"absolute inset-0 topo-pattern pointer-events-none\" data-kid=\"22\"></div>\n    <div class=\"flex divide-x divide-zinc-800 relative z-10\" data-kid=\"23\">\n      <div class=\"flex-1 py-10 px-12 flex flex-col gap-1\" data-kid=\"24\">\n        <div class=\"flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-[#eab308]/60\" data-kid=\"25\">\n          <i class=\"ti ti-device-heart-monitor\" data-kid=\"26\"></i> Terminales Activas\n        </div>\n        <div class=\"flex items-end gap-3\" data-kid=\"27\">\n          <span class=\"text-6xl font-serif leading-none italic\" data-kid=\"28\">24</span>\n          <div class=\"flex items-center gap-1 text-emerald-500 text-xs font-bold mb-1\" data-kid=\"29\">\n            <i class=\"ti ti-trending-up\" data-kid=\"30\"></i> 12%\n          </div>\n        </div>\n      </div>\n      <div class=\"flex-1 py-10 px-12 flex flex-col gap-1\" data-kid=\"31\">\n        <div class=\"flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-zinc-500\" data-kid=\"32\">\n          <i class=\"ti ti-users\" data-kid=\"33\"></i> Usuarios Hoy\n        </div>\n        <div class=\"flex items-end gap-3\" data-kid=\"34\">\n          <span class=\"text-6xl font-serif leading-none\" data-kid=\"35\">142</span>\n        </div>\n      </div>\n      <div class=\"flex-1 py-10 px-12 flex flex-col gap-1\" data-kid=\"36\">\n        <div class=\"flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-red-500/80\" data-kid=\"37\">\n          <i class=\"ti ti-alert-octagon\" data-kid=\"38\"></i> Alertas Pendientes\n        </div>\n        <div class=\"flex items-end gap-3\" data-kid=\"39\">\n          <span class=\"text-6xl font-serif leading-none text-red-600\" data-kid=\"40\">03</span>\n        </div>\n      </div>\n      <div class=\"flex-1 py-10 px-12 flex flex-col gap-1\" data-kid=\"41\">\n        <div class=\"flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-zinc-500\" data-kid=\"42\">\n          <i class=\"ti ti-clock\" data-kid=\"43\"></i> Tiempo Promedio\n        </div>\n        <div class=\"flex items-end gap-3\" data-kid=\"44\">\n          <span class=\"text-6xl font-serif leading-none\" data-kid=\"45\">1h 45m</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <main class=\"flex-1 flex flex-col p-12 gap-8\" data-kid=\"46\">\n    <div class=\"flex items-center justify-between\" data-kid=\"47\">\n      <h2 class=\"text-2xl font-bold tracking-tight flex items-center gap-3\" data-kid=\"48\">\n        <span class=\"w-1 h-8 bg-[#eab308]\" data-kid=\"49\"></span>\n        ESTADO DE FLOTA // <span class=\"text-zinc-500\" data-kid=\"50\">BIBLIOTECA CENTRAL</span>\n      </h2>\n      <div class=\"flex gap-4\" data-kid=\"51\">\n        <button class=\"px-6 py-2 bg-zinc-800 hover:bg-zinc-700 transition-colors text-xs font-bold uppercase tracking-widest rounded flex items-center gap-2\" data-kid=\"52\">\n          <i class=\"ti ti-search\" data-kid=\"53\"></i> Filtrar\n        </button>\n        <button class=\"px-6 py-2 bg-red-600/10 text-red-500 border border-red-600/30 hover:bg-red-600 hover:text-white transition-all text-xs font-bold uppercase tracking-widest rounded flex items-center gap-2\" data-kid=\"54\">\n          <i class=\"ti ti-lock\" data-kid=\"55\"></i> Bloqueo Global\n        </button>\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-1 gap-4 overflow-y-auto pr-2 custom-scrollbar\" data-kid=\"56\">\n      \n      \n      <div class=\"group relative flex items-center bg-[#121212] border border-zinc-800 p-5 rounded-lg hover:border-[#eab308]/40 transition-all overflow-hidden\" data-kid=\"57\">\n        <div class=\"w-24 h-16 rounded overflow-hidden mr-8 border border-zinc-700 shrink-0\" data-kid=\"58\">\n          <img src=\"https://images.unsplash.com/photo-1667670778881-537035257bd8?auto=format&w=200&q=80&fit=crop\" alt=\"PC Status\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"59\">\n        </div>\n        \n        <div class=\"flex-1 grid grid-cols-4 gap-8\" data-kid=\"60\">\n          <div class=\"flex flex-col\" data-kid=\"61\">\n            <span class=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-1\" data-kid=\"62\">Terminal ID</span>\n            <span class=\"text-lg font-bold tracking-tight\" data-kid=\"63\">MEICAGOD</span>\n            <span class=\"text-[10px] font-mono text-zinc-600\" data-kid=\"64\">IP: 10.21.1.121</span>\n          </div>\n          <div class=\"flex flex-col\" data-kid=\"65\">\n            <span class=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-1\" data-kid=\"66\">Usuario Actual</span>\n            <span class=\"text-lg font-bold tracking-tight text-[#eab308]\" data-kid=\"67\">Jorge Miller Nuñez</span>\n            <span class=\"text-[10px] text-zinc-600\" data-kid=\"68\">FACULTAD DE CIENCIAS</span>\n          </div>\n          <div class=\"flex flex-col\" data-kid=\"69\">\n            <span class=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-1\" data-kid=\"70\">Tiempo Activo</span>\n            <span class=\"text-lg font-bold tracking-tight italic\" data-kid=\"71\">2h 15m</span>\n            <div class=\"w-24 h-1 bg-zinc-800 mt-2 rounded-full overflow-hidden\" data-kid=\"72\">\n              <div class=\"h-full bg-[#eab308] w-3/4\" data-kid=\"73\"></div>\n            </div>\n          </div>\n          <div class=\"flex flex-col justify-center\" data-kid=\"74\">\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 bg-red-600/10 border border-red-600/30 rounded text-red-500 text-[10px] font-black w-fit uppercase tracking-tighter\" data-kid=\"75\">\n              <span class=\"w-1.5 h-1.5 bg-red-500 rounded-full animate-pulse\" data-kid=\"76\"></span>\n              Ocupado // Investigando\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"flex gap-2 translate-x-4 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300 mr-4\" data-kid=\"77\">\n          <button class=\"w-10 h-10 bg-zinc-800 hover:bg-zinc-700 rounded flex items-center justify-center transition-colors\" title=\"Ver Actividad\" data-kid=\"78\">\n            <i class=\"ti ti-activity\" data-kid=\"79\"></i>\n          </button>\n          <button class=\"w-10 h-10 bg-zinc-800 hover:bg-zinc-700 rounded flex items-center justify-center transition-colors\" title=\"Enviar Mensaje\" data-kid=\"80\">\n            <i class=\"ti ti-message\" data-kid=\"81\"></i>\n          </button>\n          <button class=\"w-10 h-10 bg-red-600 hover:bg-red-700 text-white rounded flex items-center justify-center transition-colors\" title=\"Bloquear Terminal\" data-kid=\"82\">\n            <i class=\"ti ti-lock\" data-kid=\"83\"></i>\n          </button>\n        </div>\n      </div>\n\n      \n      <div class=\"group relative flex items-center bg-[#121212] border border-zinc-800 p-5 rounded-lg hover:border-emerald-500/40 transition-all overflow-hidden\" data-kid=\"84\">\n        <div class=\"w-24 h-16 rounded overflow-hidden mr-8 border border-zinc-700 shrink-0\" data-kid=\"85\">\n          <img src=\"https://images.unsplash.com/photo-1546146477-15a587cd3fcb?auto=format&w=200&q=80&fit=crop\" alt=\"PC Status\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover opacity-20\" data-kid=\"86\">\n        </div>\n        \n        <div class=\"flex-1 grid grid-cols-4 gap-8\" data-kid=\"87\">\n          <div class=\"flex flex-col\" data-kid=\"88\">\n            <span class=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-1\" data-kid=\"89\">Terminal ID</span>\n            <span class=\"text-lg font-bold tracking-tight\" data-kid=\"90\">PC-04</span>\n            <span class=\"text-[10px] font-mono text-zinc-600\" data-kid=\"91\">IP: 10.21.1.124</span>\n          </div>\n          <div class=\"flex flex-col\" data-kid=\"92\">\n            <span class=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-1\" data-kid=\"93\">Usuario Actual</span>\n            <span class=\"text-lg font-bold tracking-tight text-zinc-700 italic\" data-kid=\"94\">Desocupada</span>\n          </div>\n          <div class=\"flex flex-col\" data-kid=\"95\">\n            <span class=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-1\" data-kid=\"96\">Última Sesión</span>\n            <span class=\"text-lg font-bold tracking-tight\" data-kid=\"97\">14:20 PM</span>\n          </div>\n          <div class=\"flex flex-col justify-center\" data-kid=\"98\">\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 bg-emerald-500/10 border border-emerald-500/30 rounded text-emerald-500 text-[10px] font-black w-fit uppercase tracking-tighter\" data-kid=\"99\">\n              <i class=\"ti ti-shield-check\" data-kid=\"100\"></i>\n              Disponible\n            </div>\n          </div>\n        </div>\n\n        <div class=\"flex gap-2 translate-x-4 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300 mr-4\" data-kid=\"101\">\n          <button class=\"px-6 h-10 bg-[#eab308] text-black font-black text-[10px] rounded uppercase tracking-widest hover:bg-[#eab308]/80 transition-colors\" data-kid=\"102\">\n            Desbloquear Manual\n          </button>\n        </div>\n      </div>\n\n      \n      <div class=\"group relative flex items-center bg-[#121212] border border-zinc-800 p-5 rounded-lg hover:border-orange-500/40 transition-all overflow-hidden\" data-kid=\"103\">\n        <div class=\"w-24 h-16 rounded overflow-hidden mr-8 border border-zinc-700 shrink-0\" data-kid=\"104\">\n          <img src=\"https://images.unsplash.com/photo-1700427296131-0cc4c4610fc6?auto=format&w=200&q=80&fit=crop\" alt=\"PC Status\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover opacity-60\" data-kid=\"105\">\n        </div>\n        \n        <div class=\"flex-1 grid grid-cols-4 gap-8\" data-kid=\"106\">\n          <div class=\"flex flex-col\" data-kid=\"107\">\n            <span class=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-1\" data-kid=\"108\">Terminal ID</span>\n            <span class=\"text-lg font-bold tracking-tight\" data-kid=\"109\">YOTSUBITA</span>\n            <span class=\"text-[10px] font-mono text-zinc-600\" data-kid=\"110\">IP: 10.21.1.123</span>\n          </div>\n          <div class=\"flex flex-col\" data-kid=\"111\">\n            <span class=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-1\" data-kid=\"112\">Usuario Actual</span>\n            <span class=\"text-lg font-bold tracking-tight text-[#eab308]\" data-kid=\"113\">Abel Aniceto</span>\n            <span class=\"text-[10px] text-orange-500/80 font-bold uppercase tracking-tighter\" data-kid=\"114\">Proceso Sospechoso: cmd.exe</span>\n          </div>\n          <div class=\"flex flex-col\" data-kid=\"115\">\n            <span class=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-1\" data-kid=\"116\">Tiempo Activo</span>\n            <span class=\"text-lg font-bold tracking-tight italic\" data-kid=\"117\">0h 45m</span>\n          </div>\n          <div class=\"flex flex-col justify-center\" data-kid=\"118\">\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 bg-orange-600/10 border border-orange-600/30 rounded text-orange-500 text-[10px] font-black w-fit uppercase tracking-tighter\" data-kid=\"119\">\n              <i class=\"ti ti-alert-triangle-filled\" data-kid=\"120\"></i>\n              Bajo Auditoría\n            </div>\n          </div>\n        </div>\n\n        <div class=\"flex gap-2 translate-x-4 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300 mr-4\" data-kid=\"121\">\n          <button class=\"w-10 h-10 bg-orange-600 text-white rounded flex items-center justify-center transition-colors\" data-kid=\"122\">\n            <i class=\"ti ti-warning-octagon\" data-kid=\"123\"></i>\n          </button>\n          <button class=\"w-10 h-10 bg-red-600 text-white rounded flex items-center justify-center transition-colors\" data-kid=\"124\">\n            <i class=\"ti ti-lock\" data-kid=\"125\"></i>\n          </button>\n        </div>\n      </div>\n\n    </div>\n\n    \n    <div class=\"mt-8 grid grid-cols-3 gap-8\" data-kid=\"126\">\n      <div class=\"col-span-2 bg-[#121212] border border-zinc-800 rounded-lg p-8 flex flex-col gap-6\" data-kid=\"127\">\n        <h3 class=\"text-lg font-bold tracking-tight flex items-center gap-2 uppercase tracking-[0.1em]\" data-kid=\"128\">\n          <i class=\"ti ti-alert-octagon text-[#eab308]\" data-kid=\"129\"></i> Centro de Incidencias // <span class=\"text-zinc-500\" data-kid=\"130\">Últimas 24h</span>\n        </h3>\n        <div class=\"flex flex-col divide-y divide-zinc-800/50\" data-kid=\"131\">\n          <div class=\"py-4 flex items-center justify-between\" data-kid=\"132\">\n            <div class=\"flex items-center gap-4\" data-kid=\"133\">\n              <div class=\"w-2 h-2 bg-[#eab308] rounded-full shadow-[0_0_8px_#eab308]\" data-kid=\"134\"></div>\n              <div class=\"flex flex-col\" data-kid=\"135\">\n                <span class=\"text-sm font-bold uppercase tracking-wide\" data-kid=\"136\">Jorge Miller Nuñez</span>\n                <span class=\"text-[10px] text-zinc-500\" data-kid=\"137\">Uso indebido de consola de sistema en terminal YORU</span>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"138\">\n              <span class=\"text-[10px] font-mono text-zinc-600 uppercase\" data-kid=\"139\">Hace 2 horas</span>\n              <button class=\"text-[10px] font-black text-[#eab308] border-b border-transparent hover:border-[#eab308] transition-all\" data-kid=\"140\">GESTIONAR</button>\n            </div>\n          </div>\n          <div class=\"py-4 flex items-center justify-between opacity-60\" data-kid=\"141\">\n            <div class=\"flex items-center gap-4\" data-kid=\"142\">\n              <div class=\"w-2 h-2 bg-zinc-700 rounded-full\" data-kid=\"143\"></div>\n              <div class=\"flex flex-col\" data-kid=\"144\">\n                <span class=\"text-sm font-bold uppercase tracking-wide\" data-kid=\"145\">Cristian Arnold Poma</span>\n                <span class=\"text-[10px] text-zinc-500\" data-kid=\"146\">Exceso de tiempo en sesión, ignoró avisos de cierre</span>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"147\">\n              <span class=\"text-[10px] font-mono text-zinc-600 uppercase\" data-kid=\"148\">Ayer</span>\n              <button class=\"text-[10px] font-black text-zinc-400 border-b border-transparent hover:border-zinc-400 transition-all\" data-kid=\"149\">REVISAR</button>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"bg-[#eab308]/5 border border-[#eab308]/20 rounded-lg p-8 flex flex-col justify-between\" data-kid=\"150\">\n        <div data-kid=\"151\">\n          <h3 class=\"text-sm font-black uppercase tracking-widest text-[#eab308] mb-6 italic font-serif\" data-kid=\"152\">Quick Audit Report</h3>\n          <div class=\"space-y-4\" data-kid=\"153\">\n            <div class=\"flex justify-between items-end border-b border-zinc-800 pb-2\" data-kid=\"154\">\n              <span class=\"text-[10px] font-bold text-zinc-500 uppercase tracking-tighter\" data-kid=\"155\">Integridad Sistema</span>\n              <span class=\"text-sm font-black text-emerald-500\" data-kid=\"156\">99.8%</span>\n            </div>\n            <div class=\"flex justify-between items-end border-b border-zinc-800 pb-2\" data-kid=\"157\">\n              <span class=\"text-[10px] font-bold text-zinc-500 uppercase tracking-tighter\" data-kid=\"158\">Peticiones Bloqueadas</span>\n              <span class=\"text-sm font-black text-white\" data-kid=\"159\">4,291</span>\n            </div>\n            <div class=\"flex justify-between items-end border-b border-zinc-800 pb-2\" data-kid=\"160\">\n              <span class=\"text-[10px] font-bold text-zinc-500 uppercase tracking-tighter\" data-kid=\"161\">Uso de Banda Ancha</span>\n              <span class=\"text-sm font-black text-[#eab308]\" data-kid=\"162\">Normal</span>\n            </div>\n          </div>\n        </div>\n        <button class=\"w-full py-4 bg-zinc-900 border border-zinc-700 text-[10px] font-black uppercase tracking-[0.3em] hover:bg-black transition-all\" data-kid=\"163\">\n          Descargar Auditoría Completa\n        </button>\n      </div>\n    </div>\n  </main>\n\n  \n  <footer class=\"h-10 bg-black border-t border-zinc-800 px-12 flex items-center justify-between text-[10px] font-bold text-zinc-600 uppercase tracking-widest\" data-kid=\"164\">\n    <div class=\"flex gap-8\" data-kid=\"165\">\n      <div class=\"flex items-center gap-2\" data-kid=\"166\">\n        <span class=\"w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_8px_#10b981]\" data-kid=\"167\"></span>\n        UPLINK ESTABLISHED\n      </div>\n      <div class=\"flex items-center gap-2\" data-kid=\"168\">\n        <span class=\"w-2 h-2 rounded-full bg-emerald-500\" data-kid=\"169\"></span>\n        WEBSOCKET CLUSTERS: 4/4\n      </div>\n    </div>\n    <div class=\"flex items-center gap-6\" data-kid=\"170\">\n      <div data-kid=\"171\">SISTEMA // <span class=\"text-[#eab308]\" data-kid=\"172\">LIB_AUDIT_V2.0.4</span></div>\n      <div class=\"flex items-center gap-2 font-mono\" data-kid=\"173\">\n        <i class=\"ti ti-clock\" data-kid=\"174\"></i> 14:28:36\n      </div>\n    </div>\n  </footer>\n\n</div>",
