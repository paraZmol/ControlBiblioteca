      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap');\n  @import url('https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css');\n\n  body {\n    font-family: 'Inter', sans-serif;\n    background-color: #09090b; /* zinc-950 */\n    color: #f4f4f5; /* zinc-100 */\n    margin: 0;\n    overflow: hidden;\n  }\n\n  .font-mono {\n    font-family: 'JetBrains Mono', monospace;\n  }\n\n  .glass-surface {\n    background-color: rgba(24, 24, 27, 0.6); /* zinc-900/60 */\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(63, 63, 70, 0.3); /* zinc-700/30 */\n  }\n\n  .wasabi-glow {\n    box-shadow: 0 0 20px rgba(120, 209, 59, 0.15);\n  }\n\n  .status-border-active {\n    border-top: 2px solid #78d13b;\n  }\n\n  .status-border-offline {\n    border-top: 2px solid #3f3f46;\n  }\n\n  .custom-scrollbar::-webkit-scrollbar {\n    width: 4px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    background: rgba(113, 113, 122, 0.2);\n    border-radius: 10px;\n  }\n</style>\n\n<div class=\"flex h-screen w-full relative\" data-kid=\"1\">\n  \n  \n  <aside class=\"w-[260px] h-full glass-surface border-r border-zinc-800 flex flex-col z-20\" data-kid=\"2\">\n    <div class=\"p-8 flex items-center gap-3\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center shadow-lg shadow-indigo-500/20\" data-kid=\"4\">\n        <i class=\"ph ph-shield-chevron text-2xl text-white\" data-kid=\"5\"></i>\n      </div>\n      <div data-kid=\"6\">\n        <h1 class=\"font-extrabold text-sm tracking-tight text-white\" data-kid=\"7\">UNASAM</h1>\n        <p class=\"text-[10px] font-mono text-zinc-500 uppercase tracking-widest leading-none\" data-kid=\"8\">Control Lib v4.0</p>\n      </div>\n    </div>\n\n    <nav class=\"flex-1 px-4 spa