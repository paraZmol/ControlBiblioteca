    \n        <div class=\"xl:col-span-2 relative overflow-hidden rounded-3xl border border-zinc-800/80 bg-zinc-900/70 backdrop-blur-md p-7 group hover:-translate-y-0.5 hover:border-zinc-700 transition-all duration-300\" data-kid=\"65\">\n          <div class=\"absolute -top-10 -right-10 w-56 h-56 rounded-full bg-indigo-500/10 blur-[80px]\" data-kid=\"66\"></div>\n          <div class=\"relative z-10 flex flex-col h-full justify-between\" data-kid=\"67\">\n            <div class=\"flex items-start justify-between gap-4\" data-kid=\"68\">\n              <div data-kid=\"69\">\n                <h2 class=\"text-3xl font-extrabold tracking-tight text-zinc-100\" data-kid=\"70\">Centro de Control</h2>\n                <p class=\"mt-1.5 flex items-center gap-2 text-xs font-medium text-zinc-400\" data-kid=\"71\">\n                  <span class=\"relative flex h-2 w-2\" data-kid=\"72\">\n                    <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\" data-kid=\"73\"></span>\n                    <span class=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-400\" data-kid=\"74\"></span>\n                  </span>\n                  Sistema operando en tiempo real\n                </p>\n              </div>\n              <button class=\"shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-zinc-100 text-zinc-900 text-sm font-bold hover:bg-white transition-colors shadow-lg shadow-black/20\" data-kid=\"75\">\n                <i class=\"ph ph-lock-key\" data-kid=\"76\"></i> Bloquear Sala\n              </button>\n            </div>\n\n            <div class=\"flex flex-wrap items-end gap-8 mt-8\" data-kid=\"77\">\n              <div data-kid=\"78\">\n                <p class=\"text-[11px] font-bold uppercase tracking-wider text-zinc-500\" data-kid=\"79\">Equipos Online</p>\n                <p class=\"text-4xl font-extrabold text-emerald-400 mt-1\" data-kid=\"80\">4<span class=\"text-lg font-medium text-zinc-